# Copy to .env for local development. In production, set these as real environment variables.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5433/placerating
# Set to true for hosted databases that require TLS
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Your iOS app's bundle id; Apple puts it in the identity token's `aud` claim
APPLE_BUNDLE_ID=com.example.PlaceRating

# Local only: lets you sign in with POST /auth/dev {"username": "..."} without Apple. Refused in production.
DEV_AUTH_ENABLED=true

# Google sign-in: comma-separated OAuth client ids (the iOS client id from Google Cloud). Empty turns it off.
GOOGLE_CLIENT_IDS=

# Email and password sign-in with 6-digit codes. MAIL_PROVIDER=log prints emails (and their codes) to
# this server's log, for development only; production needs MAIL_PROVIDER=resend with a verified domain.
# Contact address on the /terms and /privacy pages (defaults to the owner's address).
SUPPORT_EMAIL=
EMAIL_AUTH_ENABLED=true
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=

# Place photos (the fake S3 from docker-compose; it accepts any credentials)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=place-rating
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
# Creates the bucket on startup if missing (ignored in production)
S3_AUTO_CREATE_BUCKET=true
# The public address of THIS API. The bucket stays private; place photo URLs look like
# <this>/photos/<place id>/<file>.jpg and the API streams them. On a real iPhone use your Mac's LAN address.
PUBLIC_BASE_URL=http://localhost:3000
